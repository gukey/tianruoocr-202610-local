<Project>
  <!-- Emgu 4.5.5 ships VC++ 14.29 app-local files. They override a newer
       installed VC++ runtime and crash ONNX Runtime 1.31 during OrtEnv creation.
       Use the system VC++ 2015-2022 x64 redistributable instead. -->
  <Target Name="RemoveLegacyAppLocalVCRuntime" AfterTargets="Build">
    <ItemGroup>
      <LegacyVCRuntime Include="$(TargetDir)msvcp140*.dll;$(TargetDir)vcruntime140*.dll;$(TargetDir)concrt140.dll" />
    </ItemGroup>
    <Delete Files="@(LegacyVCRuntime)" />
  </Target>
  <!-- 这些组件不在截图识别调用链中，重建时同时清除旧输出残留。 -->
  <Target Name="RemoveUnusedScreenshotRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <UnusedScreenshotRuntime Include="$(TargetDir)opencv_videoio_ffmpeg455_64.dll;$(TargetDir)INIFileParser.dll;$(TargetDir)Emgu.CV.Platform.NetFramework.dll;$(TargetDir)System.Diagnostics.DiagnosticSource.dll;$(TargetDir)System.Text.Encodings.Web.dll;$(TargetDir)zxing.presentation.dll;$(TargetDir)DLL/pinyin.txt;$(TargetDir)models/paddle-ocr/*.onnx;$(TargetDir)models/paddle-ocr/*.txt" />
    </ItemGroup>
    <Delete Files="@(UnusedScreenshotRuntime)" />
  </Target>
</Project>
